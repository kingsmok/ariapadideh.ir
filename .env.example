# Flask Pro Environment Configuration

# Application
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-string

# Database
DATABASE_URL=sqlite:///instance/app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/flask_pro

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache
CACHE_TYPE=RedisCache

# Session
SESSION_TYPE=redis

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# SMS / OTP (ورود با موبایل — درایور: console | kavenegar | mellipayamak | smsir)
SMS_DRIVER=console
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
# MELLIPAYAMAK_USERNAME=
# MELLIPAYAMAK_PASSWORD=
# MELLIPAYAMAK_LINE=
# SMSIR_API_KEY=
# SMSIR_LINE=

# AI Content (پیش‌نویس با هوش مصنوعی — سازگار با OpenAI/OpenRouter/Groq)
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Site Settings
SITE_NAME=فلاسک پرو
SITE_URL=https://example.com

# CDN (optional)
CDN_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cookie
COOKIE_SECURE=False

# ==================== Payment Gateways ====================
# درگاه‌های فعال (کاما جدا شده): mock, zarinpal, idpay, digipay, snapppay, sepah
# ترتیب = ترتیب نمایش به مشتری. کلیدها را می‌توانید از پنل مدیریت
# (تنظیمات → درگاه پرداخت) هم وارد کنید — پنل بر .env اولویت دارد.
ENABLED_PAYMENT_GATEWAYS=mock,zarinpal

# واحد مبالغ فروشگاه (درگاه‌ها ریالی‌اند؛ اگر مبالغ به تومان ذخیره شده‌اند خودکار ×۱۰ می‌شود)
PAYMENT_CURRENCY_UNIT=toman

# --- زرین‌پال (PG v4 — payment.zarinpal.com/pg/v4) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False

# --- آی‌دی‌پی (v1.1 — api.idpay.ir/v1.1) ---
IDPAY_API_KEY=
IDPAY_SANDBOX=False

# --- دیجی‌پی (UPG — oauth + tickets/business?type=11) ---
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_SANDBOX=False

# --- اسنپ‌پی اقساطی (oauth + payment/v1/token — مستندات محرمانه از پشتیبانی) ---
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=
SNAPPPAY_SANDBOX=False

# --- بانک سپه (الگوی استاندارد شاپرک/سپهر — پذیرندگی سپه از PSP همکار) ---
SEPASH_TERMINAL_ID=
SEPASH_API_BASE=https://sepehr.shaparak.ir:8081
SEPASH_PAY_BASE=https://sepehr.shaparak.ir:8080
